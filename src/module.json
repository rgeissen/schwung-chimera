{
 "id": "chimera",
 "name": "Schimera",
 "abbrev": "SCHIM",
 "version": "0.6.1.1",
 "description": "A physically modeled human voice: every sound comes from a simulated airway (lungs, vocal folds, tongue, lips, nose), not samples. Speak a line of text at a key's pitch, sing it a syllable per key, or play a held vowel and sweep it with pad pressure. Port of jamesondh's CHIMERA engine, lightened to run on the Move.",
 "author": "legsmechanical (engine: Jameson Hodge / CHIMERA)",
 "license": "MIT",
 "ui": "ui.js",
 "dsp": "dsp.so",
 "api_version": 2,
 "min_host_version": "1.8.0",
 "capabilities": {
  "audio_out": true,
  "audio_in": false,
  "midi_in": true,
  "midi_out": false,
  "aftertouch": true,
  "chainable": true,
  "component_type": "sound_generator",
  "chain_params": [
  {"key":"mode","name":"Mode","type":"enum","options":["Speak","Sing","Vowel"],"default":0},
  {"key":"words","name":"Words","type":"enum","options":["Custom","Made of Air","Twinkle","Daisy Bell","Hello","Ah","Ooh","La","Doo"],"default":1},
  {"key":"volume","name":"Volume","type":"float","min":0,"max":1,"default":0.8},
  {"key":"female","name":"Female","type":"float","min":0,"max":1,"default":0},
  {"key":"child","name":"Child","type":"float","min":0,"max":1,"default":0},
  {"key":"breath","name":"Breath","type":"float","min":2,"max":22,"default":8},
  {"key":"pressed","name":"Pressed","type":"float","min":0,"max":1,"default":0.5},
  {"key":"vibrato","name":"Vibrato","type":"float","min":0,"max":120,"default":35},
  {"key":"vib_rate","name":"Vib Rate","type":"float","min":3,"max":9,"default":6},
  {"key":"glide","name":"Glide","type":"float","min":5,"max":600,"default":60},
  {"key":"hold","name":"Hold","type":"enum","options":["Off","On"],"default":0},
  {"key":"bright","name":"Bright","type":"float","min":0,"max":1,"default":0.25},
  {"key":"breathy","name":"Breathy","type":"float","min":0,"max":1,"default":0.15},
  {"key":"rough","name":"Rough","type":"float","min":0,"max":1,"default":0.1},
  {"key":"fry","name":"Fry","type":"float","min":0,"max":1,"default":0},
  {"key":"whisper","name":"Whisper","type":"enum","options":["Off","On"],"default":0},
  {"key":"drift","name":"Drift","type":"float","min":0,"max":20,"default":5},
  {"key":"vowel","name":"Pick Vowel","type":"enum","options":["Ah","Ee","Ih","Ay","Eh","Ae","Aw","Oh","Uh","Oo","Book","Er","Schwa"],"default":0},
  {"key":"tongue_x","name":"Tng Front","type":"float","min":0,"max":1,"default":0.5},
  {"key":"tongue_y","name":"Tng High","type":"float","min":0,"max":1,"default":0.5},
  {"key":"jaw","name":"Jaw","type":"float","min":0,"max":1,"default":0.25},
  {"key":"lips","name":"Lips Open","type":"float","min":0,"max":1,"default":0.4},
  {"key":"round","name":"Round","type":"float","min":0,"max":1,"default":0.5},
  {"key":"protrude","name":"Protrude","type":"float","min":0,"max":1,"default":0.2},
  {"key":"nasal","name":"Nasal","type":"float","min":0,"max":1,"default":0.07},
  {"key":"larynx","name":"Larynx","type":"float","min":0,"max":1,"default":0.5},
  {"key":"twang","name":"Twang","type":"float","min":0,"max":1,"default":0},
  {"key":"false_folds","name":"False Fld","type":"float","min":0,"max":1,"default":0},
  {"key":"tip_curl","name":"Tip Curl","type":"float","min":0,"max":1,"default":0},
  {"key":"tongue_root","name":"Tng Root","type":"float","min":0,"max":1,"default":0.5},
  {"key":"lateral","name":"Lateral","type":"float","min":0,"max":1,"default":0},
  {"key":"rate","name":"Rate","type":"float","min":0.5,"max":2,"default":1},
  {"key":"expression","name":"Expression","type":"float","min":0,"max":1,"default":0.35},
  {"key":"position","name":"Position","type":"int","min":0,"max":255,"default":0},
  {"key":"sweep","name":"Vowel","type":"float","min":0,"max":1,"default":0.5},
  {"key":"press_amt","name":"Pressure","type":"float","min":-1,"max":1,"default":0.5},
  {"key":"legato","name":"Legato","type":"enum","options":["Next","Hold"],"default":0}
  ]
 }
}
